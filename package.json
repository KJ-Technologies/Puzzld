{
  "name": "puzzld",
  "version": "1.1.0",
  "private": true,
  "description": "Puzzld — a playful, photo-led online jigsaw puzzle experience by KJ Technologies.",
  "scripts": {
    "start": "npm start --prefix backend",
    "dev": "concurrently --kill-others-on-fail --names backend,frontend \"npm start --prefix backend\" \"npm start --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "format": "prettier --write \"frontend/src/**/*.{js,jsx,css}\" \"frontend/public/game/**/*.{js,css}\" \"backend/**/*.js\"",
    "format:check": "prettier --check \"frontend/src/**/*.{js,jsx,css}\" \"frontend/public/game/**/*.{js,css}\" \"backend/**/*.js\""
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "3.9.10"
  }
}
